{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devilesk/dota-interactive-map/dota-knowledge/abilities.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "abilities",
    "activations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "abilities": {
      "type": "array",
      "items": {
        "$ref": "core.schema.json#/$defs/ability"
      }
    },
    "activations": {
      "type": "array",
      "items": {
        "$ref": "core.schema.json#/$defs/activation"
      }
    }
  },
  "additionalProperties": false
}
