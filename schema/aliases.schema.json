{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devilesk/dota-interactive-map/dota-knowledge/aliases.schema.json",
  "description": "Flat lookup from a lowercase normalized alias to one canonical hero key. Ambiguous aliases are omitted unless the documented policy resolves them.",
  "type": "object",
  "minProperties": 1,
  "propertyNames": {
    "minLength": 1,
    "pattern": "^[^A-Z]+$"
  },
  "patternProperties": {
    ".+": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$"
    }
  },
  "additionalProperties": false
}
