{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devilesk/dota-interactive-map/dota-knowledge/identity-ledger.schema.json",
  "title": "Historical identity reconciliation",
  "type": "object",
  "required": [
    "schemaVersion",
    "archive",
    "entries",
    "generation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "archive": {
      "$ref": "preservation-reference.schema.json"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "oldIdentitySha256",
          "newId",
          "beforeSha256",
          "afterSha256"
        ],
        "properties": {
          "kind": {
            "enum": [
              "source",
              "observation"
            ]
          },
          "oldIdentitySha256": {
            "$ref": "core.schema.json#/$defs/hash"
          },
          "newId": {
            "type": "string",
            "minLength": 1
          },
          "beforeSha256": {
            "$ref": "core.schema.json#/$defs/hash"
          },
          "afterSha256": {
            "$ref": "core.schema.json#/$defs/hash"
          }
        },
        "additionalProperties": false
      }
    },
    "generation": {
      "type": "object",
      "required": [
        "createdAt",
        "generatedAt",
        "preservation"
      ],
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "preservation": {
          "$ref": "preservation-reference.schema.json"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
