{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devilesk/dota-interactive-map/dota-knowledge/item-profile.schema.json",
  "title": "Dota item profile",
  "description": "A compact item profile with the same ability fields used by hero ability views.",
  "type": "object",
  "required": ["id", "key", "sourceKey", "name", "aliases", "description", "lore", "notes", "neutralTiers"],
  "properties": {
    "id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "key": { "type": "string", "pattern": "^[a-z0-9]+(?:[_-][a-z0-9]+)*$" },
    "sourceKey": { "type": "string", "pattern": "^item_[a-z0-9_]+$" },
    "name": { "type": ["string", "null"] },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "pattern": "^[^A-Z]+$" }
    },
    "description": { "type": ["string", "null"] },
    "lore": { "type": ["string", "null"] },
    "notes": { "type": "array", "items": { "type": "string" } },
    "neutralTiers": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
    "cost": { "type": "number", "minimum": 0 },
    "shopTags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "quality": { "type": "string", "minLength": 1 },
    "purchasable": { "type": "boolean" },
    "sellable": { "type": "boolean" },
    "permanent": { "type": "boolean" },
    "stackable": { "type": "boolean" },
    "droppable": { "type": "boolean" },
    "killable": { "type": "boolean" },
    "requiresCharges": { "type": "boolean" },
    "maxStack": { "type": "number", "minimum": 0 },
    "baseLevel": { "type": "number", "minimum": 0 },
    "maxUpgradeLevel": { "type": "number", "minimum": 0 },
    "initialCharges": { "type": "number", "minimum": 0 },
    "displayCharges": { "type": "number", "minimum": 0 },
    "chargeRestoreTime": { "type": "number", "minimum": 0 },
    "shareability": { "enum": ["fully-shareable", "partially-shareable", "not-shareable"] },
    "disassembleRule": { "enum": ["always", "never"] },
    "recipe": { "type": "boolean" },
    "recipeResult": { "type": "string", "pattern": "^item_[a-z0-9_]+$" },
    "recipeRequirements": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "string", "minLength": 1 } }
    },
    "upgradeRecipe": { "type": "string", "pattern": "^item_[a-z0-9_]+$" },
    "upgradesItems": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^item_[a-z0-9_]+$" }
    },
    "ability": { "$ref": "#/$defs/ability" }
  },
  "additionalProperties": false,
  "$defs": {
    "quantity": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "type": "array", "minItems": 1, "items": { "type": "number", "minimum": 0 } }
      ]
    },
    "ability": {
      "type": "object",
      "required": ["id", "tags"],
      "properties": {
        "id": { "type": "string", "pattern": "^item_[a-z0-9_]+$" },
        "type": { "enum": ["passive", "toggle", "target", "point", "vector", "target-or-point", "self-target", "placeholder"] },
        "behavior": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["unit-target", "passive", "point-target", "no-target", "auto-cast", "channeled", "point-vector-target", "toggle", "tree-vector-target"] }
        },
        "target": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["self", "ally_hero", "enemy_hero", "ally_creep", "enemy_creep", "neutral_creep", "enemy_creep_hero", "ally_building", "enemy_building", "tree", "ally_courier", "enemy_courier"] }
        },
        "affects": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["units", "allies", "allied-units", "enemy-units", "enemy-creeps", "allied-heroes", "enemy-heroes", "trees", "allied-buildings", "enemy-buildings"] }
        },
        "manaCost": { "$ref": "#/$defs/quantity" },
        "cooldown": { "$ref": "#/$defs/quantity" },
        "castRange": { "$ref": "#/$defs/quantity" },
        "castPoint": { "$ref": "#/$defs/quantity" },
        "channelTime": { "$ref": "#/$defs/quantity" },
        "damage": { "$ref": "#/$defs/quantity" },
        "duration": { "$ref": "#/$defs/quantity" },
        "healthCost": { "$ref": "#/$defs/quantity" },
        "damageType": { "enum": ["physical", "magical", "pure"] },
        "sharedCooldown": { "type": "string" },
        "dispellable": { "enum": ["yes", "no", "strong-only"] },
        "dispelType": { "enum": ["basic", "strong"] },
        "piercesDebuffImmunity": { "enum": ["no", "allies-only", "yes"] },
        "breakable": { "type": "boolean" },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
        },
        "values": { "type": "object", "additionalProperties": { "$ref": "core.schema.json#/$defs/jsonValue" } }
      },
      "additionalProperties": false
    }
  }
}
