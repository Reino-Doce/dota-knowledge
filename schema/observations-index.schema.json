{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devilesk/dota-interactive-map/dota-knowledge/observations-index.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "projections",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "projections": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "record",
          "offset"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "record": {
            "type": "string",
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "projection": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
