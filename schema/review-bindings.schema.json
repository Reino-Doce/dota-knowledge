{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devilesk/dota-interactive-map/dota-knowledge/review-bindings.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "bindings"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "binding": {
      "type": "object",
      "required": [
        "subjectId",
        "field",
        "value"
      ],
      "properties": {
        "subjectId": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "pattern": "^/"
        },
        "value": {}
      },
      "additionalProperties": false
    }
  }
}
